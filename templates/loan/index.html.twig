{% extends 'base.html.twig' %}

{% block title %}Hello LoanController!{% endblock %}

{% block body %}
    <div class="container">
        <h1 class="h3 text-center font-weight-normal my-5">Réservation</h1>
        <div class="m-auto w-50">
        {{ form_start(form) }}
        
            <div class="my-4">
                {{ form_label(form.start) }}
                {{ form_widget(form.start) }}
                {{ form_errors(form.start) }}
            </div>

            <div class="my-4">
                {{ form_label(form.end) }}
                {{ form_widget(form.end) }}
                {{ form_errors(form.end) }}
            </div>
        <button type="submit" class="btn btn-lg btn-primary-custom">Demander le prêt</button>

        {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
