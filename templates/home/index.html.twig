{% extends 'base.html.twig' %}

{% block title %}myLoc - Partagez, Économisez, Préservez{% endblock %}

{% block body %}
    <div class="main-content">
        <!-- Hero Section -->
        <section class="hero-section">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6">
                        <h1 class="hero-title">Partagez vos objets.<br>Économisez.<br>Préservez la planète.</h1>
                        <p class="hero-subtitle">
                            Pourquoi acheter quand on peut emprunter ? myLoc connecte les voisins pour partager 
                            les objets du quotidien. Gagnez des points en prêtant, économisez en empruntant.
                        </p>
                        <div class="d-flex gap-3 flex-wrap">
                            <a href="{{ path('app_register') }}" class="btn btn-primary-custom">Commencer gratuitement</a>
                            <a href="#how-it-works" class="btn btn-outline-custom">En savoir plus</a>
                        </div>
                    </div>
                    <div class="col-lg-6 mt-5 mt-lg-0">
                        <div class="hero-image-container">
                            <img src="https://images.unsplash.com/photo-1776721977064-d4e5389db6b9?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" 
                                alt="Partage communautaire" 
                                class="img-fluid hero-image">
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Section -->
        <section class="stats-section">
            <div class="container">
                <div class="row">
                    <div class="col-md-4">
                        <div class="stat-card">
                            <div class="stat-icon">🌱</div>
                            <span class="stat-number">87%</span>
                            <div class="stat-label">Moins de CO₂</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="stat-card">
                            <div class="stat-icon">🤝</div>
                            <span class="stat-number">15k+</span>
                            <div class="stat-label">Prêts réalisés</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="stat-card">
                            <div class="stat-icon">💰</div>
                            <span class="stat-number">450€</span>
                            <div class="stat-label">Économisés en moyenne</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- How it works -->
        <section class="how-section" id="how-it-works">
            <div class="container">
                <h2 class="section-title">Comment ça marche ?</h2>
                <p class="section-subtitle">
                    En 3 étapes simples, rejoignez une communauté qui partage, économise et préserve l'environnement.
                </p>
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="step-card">
                            <div class="step-number">01</div>
                            <h3 class="step-title">Créez votre compte</h3>
                            <p class="step-description">
                                Inscrivez-vous gratuitement en quelques secondes. Renseignez votre localisation 
                                pour trouver des voisins près de chez vous.
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="step-card">
                            <div class="step-number">02</div>
                            <h3 class="step-title">Proposez vos objets</h3>
                            <p class="step-description">
                                Listez les objets que vous possédez et que vous êtes prêt à prêter : outils, 
                                électroménager, sport, loisirs... Gagnez des points à chaque prêt !
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="step-card">
                            <div class="step-number">03</div>
                            <h3 class="step-title">Empruntez facilement</h3>
                            <p class="step-description">
                                Besoin d'une perceuse pour le week-end ? Recherchez l'objet, réservez-le, 
                                récupérez-le chez votre voisin. Simple et solidaire !
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Categories -->
        <section class="categories-section" id="categories">
            <div class="container">
                <h2 class="section-title">Explorez par catégorie</h2>
                <p class="section-subtitle">
                    Des milliers d'objets disponibles dans toutes les catégories du quotidien
                </p>
                <div class="row g-4">
                    {% for category in categories %}
                        <a href="{{ path('app_categoryShow', {id: category.id}) }}" class="col-md-4">
                            <div class="category-card">
                                <img src="{{ category.picture }}" alt="...">
                                <div class="category-name">{{category.name}}</div>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="cta-section">
            <div class="container text-center position-relative">
                <h2 class="cta-title">Rejoignez la communauté myLoc</h2>
                <p class="cta-text">
                    Des milliers de personnes partagent déjà leurs objets.<br>
                    Et si vous étiez le prochain ?
                </p>
                <a href="{{ path('app_register') }}" class="btn btn-light-custom">
                    Créer mon compte gratuitement
                </a>
            </div>
        </section>
    </div>
{% endblock %}
