{% extends 'base.html.twig' %}

{% block body %}
    <div class="container">
        <h1 class="my-5">{{ category.name }}</h1>
        <div class="row gap-3 mb-5">
            {% for item in category.items %}
                <div class="card p-0" style="width: 18rem;">
                            {# <img src="{{ asset('uploads/img/'~ item.picture ) }}" class="card-img-top" alt="..."> #}
                            <img src="{{ item.picture }}" class="card-img-top" alt="...">
                            <div class="card-body">
                                <h5 class="card-title"> {{  item.name }} </h5>
                                <p class="card-text">{{ item.description|u.truncate(50,'...') }}</p>
                                <a href="/item/{{ item.id }}" class="btn btn-primary">Go somewhere</a>
                            </div>
                        </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}