{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} — myLoc{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('home') }}">Accueil</a>
    <span>›</span>
    {{ category.name }}
{% endblock %}

{% block body %}
<div class="container cat-page-show">

    <div class="cat-header-show">
        <div class="cat-label-show">Catégorie</div>
        <h1 class="cat-title-show">{{ category.name }}</h1>
        <div class="cat-count-show">{{ category.items|length }} objet{{ category.items|length > 1 ? 's' : '' }} disponible{{ category.items|length > 1 ? 's' : '' }}</div>
    </div>

    <div class="items-grid-show">
        {% for item in category.items %}
        <a href="{{ path('app_item_show', {id: item.id}) }}" class="item-card-show">
            <div class="item-thumb-show">
                {% if item.picture %}
                    <img src="{{ asset('uploads/img/' ~ item.picture) }}" alt="{{ item.name }}">
                {% else %}
                    <div class="item-thumb-placeholder-show">📦</div>
                {% endif %}
            </div>
            <div class="item-body-show">
                <div class="item-name-show">{{ item.name }}</div>
                <div class="item-desc-show">{{ item.description|u.truncate(80, '...') }}</div>
                <div class="item-cta-show">
                    <span class="item-btn-show">Voir l'objet →</span>
                </div>
            </div>
        </a>
        {% else %}
            <p class="empty-show">Aucun objet dans cette catégorie pour le moment.</p>
        {% endfor %}
    </div>

</div>
{% endblock %}