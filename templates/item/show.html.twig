{% extends 'base.html.twig' %}

{% block body %}

	<div class="d-flex justify-content-center">
		<div class="card w-50" >
			<img src="{{ asset('uploads/img/'~ item.picture ) }}" class="card-img-top" alt="...">
			<div class="card-body">
				<h5 class="card-title">
					{{  item.name }}
				</h5>
				<p class="card-text">{{ item.description}}</p>
				<a href="item/{{ item.id }}" class="btn btn-primary">Emprunter</a>
			</div>
		</div>
	</div>
{% endblock %}
