{% extends 'base.html.twig' %}

{% block title %}Ajouter un item{% endblock %}

{% block body %}
    <div class="container">
        <h1 class="h3 text-center font-weight-normal my-5">Ajouter un item</h1>
        <div class="m-auto w-50">
            {{ form_errors(AddItemType) }}

            {{ form_start(AddItemType) }}

                <div class="my-4">
                    {{ form_widget(AddItemType.name, {}) }}
                </div>

                <div class="my-4">
                    {{ form_widget(AddItemType.description) }}
                </div>

                <div class="my-4">
                    {{ form_widget(AddItemType.picture) }}
                </div>

                <div class="my-4">
                    {{ form_widget(AddItemType.category) }}
                </div>

                <button type="submit" class="btn btn-lg btn-primary-custom">Ajouter</button>
            {{ form_end(AddItemType) }}
        </div>
    </div>
{% endblock %}