{# templates/user/dashboard.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Mon espace — myLoc{% endblock %}

{% block body %}
    <div class="page container py-4">

        {# En-tête utilisateur #}
        <div class="dash-header">
            <div class="dash-avatar">
                {{ app.user.email|first|upper }}
            </div>
            <div class="dash-hello">
                <strong>Bonjour, {{ app.user.username }}</strong>
                <span>{{ app.user.username }}</span>
            </div>
        </div>
        <div class="mb-4">
            <a href="{{ path('app_edit_user', {id: app.user.id})}}" class="btn btn-outline-custom me-3">Modifier mon profil</a>
            <a href="{{ path('admin')}}" class="btn btn-outline-custom">Page administrateur</a>
        </div>


        {# Métriques #}
        <div class="metrics">
            <div class="metric">
                <div class="metric-label">Points myLoc</div>
                <div class="metric-value">{{ app.user.points }}</div>
            </div>
            <div class="metric">
                <div class="metric-label">Biens déposés</div>
                <div class="metric-value">{{ items|length }}</div>
            </div>
            <div class="metric">
                <div class="metric-label">Prêts réalisés</div>
                <div class="metric-value">{{ loans|length }}</div>
            </div>
        </div>

        {# Mes biens #}
        <div class="section-title">Mes biens</div>
        <div class="items-grid">
            {% for item in items %}
            <a href="{{ path('app_item_show', {id: item.id}) }}" class="item-card-show">
                <div class="item-thumb-show">
                    {% if item.picture %}
                        <img src="{{ asset('uploads/img/' ~ item.picture) }}" alt="{{ item.name }}">
                    {% else %}
                        📦
                    {% endif %}
                </div>
                <div class="item-body-show">
                    <div class="item-name-show">{{ item.name }}</div>
                    <div class="item-cat">{{ item.category.name }}</div>
                </div>
            </a>
            {% endfor %}

            {# Bouton ajouter #}
            <a href="{{ path('app_item_add') }}" class="item-add">
                + Ajouter un bien
            </a>
        </div>

        {# Prêts en cours #}
        <div class="section-title">Prêts en cours</div>
        <div class="loans-list">
            {% for loan in loans %}
            <div class="loan-row">
                <div class="loan-main">
                    <span class="loan-item-name">{{ loan.item.name }}</span>
                    <span class="loan-borrower">
                        Emprunté par {{ loan.user.email }}.
                    </span>
                    <span class="loan-dates">
                        {{ loan.start|date('d M') }} → {{ loan.end|date('d M Y') }}
                    </span>
                </div>
                <span class="badge {{ loan.start > date() ? 'badge-soon' : 'badge-active' }}">
                    {{ loan.start > date() ? 'À venir' : 'En cours' }}
                </span>
            </div>
            {% else %}
                <p style="color: var(--neutral-dark); opacity: .5;">Aucun prêt en cours.</p>
            {% endfor %}
        </div>

    </div>
{% endblock %}

